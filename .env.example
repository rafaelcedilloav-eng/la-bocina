# Copia este archivo a .env y llena los valores. NO subas el .env al repo.

# --- pey (se generan en portal: seccion Desarrollador) ---
PEY_API_KEY=            # Bearer token para Authorization
PEY_WEBHOOK_SECRET=     # se muestra UNA sola vez al crear el webhook: guardalo
PEY_API_BASE=https://api.pey.mx

# --- Cuenta del comercio (Candado 1) ---
# COMMERCE_MODE = cuenta_registrada  -> se manda PEY_BANK_ACCOUNT_ID en cada cobro
# COMMERCE_MODE = credencial_propia  -> la cuenta ligada a la API key ES el comercio
COMMERCE_MODE=credencial_propia
PEY_BANK_ACCOUNT_ID=    # id de la cuenta ACTIVE (solo en modo cuenta_registrada)

# --- Servidor / despliegue ---
PORT=8000
PUBLIC_URL=             # URL HTTPS fija a la que apunta el webhook

# --- Mini-MCP (bonus) ---
MCP_TOKEN=              # token propio para que solo agentes autorizados cobren
